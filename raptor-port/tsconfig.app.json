{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    /* src/state/permissions.json — the app's copy of docs/data-model.md §11, read by may() and by the
       document gate (scripts/permcheck.mjs), one data file for both (D200, 26 Sep 26) */
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* src/tracker/ is the vendored OCU Progress Tracker (7 Sep 26), written
       in plain JavaScript/JSX; allowJs lets the TS side import it (main.tsx's
       resetSession seam, TrackerPage.tsx). checkJs stays off — its bodies are
       verbatim ports and are not type-checked, only bundled. */
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
